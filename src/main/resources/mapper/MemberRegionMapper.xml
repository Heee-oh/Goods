<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.goods.market.member.infrastructure.memberRegion.mapper.MemberRegionMapper">
    <select id="isPointInRegion" resultType="boolean">
        SELECT EXISTS (
            SELECT 1
            FROM region
              AND ST_Covers(
                    geom,
                    ST_SetSRID(ST_MakePoint(#{lng}, #{lat}), 4326)
                  )
        )
    </select>
</mapper>